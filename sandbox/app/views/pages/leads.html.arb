div class: "flex-grow flex flex-col bg-gray-950 p-6 md:p-8" do
    
    # Header navigation
    header class: "flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800 pb-6 mb-8" do
      div do
        div class: "flex items-center gap-2 text-xs text-gray-400" do
          link_to "Dashboard", root_path, class: "hover:text-white"
          span "/"
          span " CRM Leads", class: "text-indigo-400"
        end
        h1 "Call Center Leads (Spark CRM)", class: "text-2xl font-bold tracking-tight text-white mt-1"
        para "Testing semantic StateResolver on a live list of CRM lead statuses", class: "text-sm text-gray-400 mt-1"
      end

      div class: "flex gap-2" do
        btn "Add Lead", color: :success, size: :sm, icon: "plus", data: { action: "click->modal-add-lead#toggle" }
        btn "Back to Dashboard", root_path, color: :neutral, size: :sm
      end
    end

    # CRM Leads Grid
    div class: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" do
      leads.each do |lead|
        card lead.name do
          line "Lead ID", "##{lead.id}"
          line "Phone", lead.phone
          line "Email", lead.email
          
          # Showcase semantic badge colors via StateResolver
          line "DB Status", badge(lead.status)
          line "Source", badge(lead.source, size: :xs)
          line "Created", auto_component(lead.created_at)

          # Action buttons inside card
          div class: "flex justify-end gap-2 mt-6 border-t border-gray-800/50 pt-4" do
            btn "Contact", color: :info, size: :xs
            btn "Delete", color: :danger, size: :xs, data: { action: "click->modal-delete-lead#toggle" }
          end
        end
      end
    end

    # Add Lead Modal (Placeholder for interactive actions)
    modal id: "modal-add-lead", open: false do
      div class: "p-6" do
        h3 "Add New Lead", class: "text-lg font-bold text-white mb-4"
        
        # Simple styled HTML form controls
        div class: "space-y-4 mb-6" do
          div do
            label "Name", class: "block text-xs font-semibold text-gray-400 mb-1"
            input type: "text", placeholder: "John Doe", class: "w-full bg-gray-900 border border-gray-800 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500"
          end
          div do
            label "Phone", class: "block text-xs font-semibold text-gray-400 mb-1"
            input type: "text", placeholder: "+1 (555) 000-0000", class: "w-full bg-gray-900 border border-gray-800 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500"
          end
        end

        div class: "flex justify-end gap-3" do
          btn "Cancel", color: :neutral, size: :sm, data: { action: "click->modal-add-lead#close" }
          btn "Create Lead", color: :success, size: :sm
        end
      end
    end

    # Delete Confirmation Modal
    modal id: "modal-delete-lead", open: false do
      div class: "p-6" do
        h3 "Delete Lead?", class: "text-lg font-bold text-white mb-2"
        para "Are you sure you want to delete this lead from Spark CRM? This data will be permanently erased.", class: "text-sm text-gray-400 mb-6"
        
        div class: "flex justify-end gap-3" do
          btn "Cancel", color: :neutral, size: :sm, data: { action: "click->modal-delete-lead#close" }
          btn "Yes, Delete", color: :danger, size: :sm
        end
      end
    end

  end
